diff --git a/src/llm/sections.js b/src/llm/sections.js
new file mode 100644
index 0000000..eba4da0
--- /dev/null
+++ b/src/llm/sections.js
@@ -0,0 +1,39 @@
+// N1-U.17.3 · Dos salidas desde una sola generación, compatibles con chunks SSE.
+// Solo el texto anterior al marcador pertenece a la respuesta del lector.
+export const AUDIT_MARKER = '<<<AGORA_AUDITORIA_V2>>>';
+
+export function createSectionSplitter(marker=AUDIT_MARKER){
+  let pending='', phase='answer', answer='', editorialAudit='';
+  function take(text){
+    if(typeof text!=='string'||!text)return {answerDelta:'',auditDelta:''};
+    if(phase==='audit') {editorialAudit+=text;return {answerDelta:'',auditDelta:text};}
+    pending+=text;
+    const at=pending.indexOf(marker);
+    if(at>=0){
+      const answerDelta=pending.slice(0,at),auditDelta=pending.slice(at+marker.length);
+      answer+=answerDelta;editorialAudit+=auditDelta;pending='';phase='audit';
+      return {answerDelta,auditDelta};
+    }
+    // Retener el mayor sufijo que podría ser el comienzo de un marcador cortado.
+    let hold=0;
+    for(let i=Math.min(marker.length-1,pending.length);i>0;i--){
+      if(pending.endsWith(marker.slice(0,i))){hold=i;break;}
+    }
+    const answerDelta=pending.slice(0,pending.length-hold);
+    pending=pending.slice(pending.length-hold);
+    answer+=answerDelta;
+    return {answerDelta,auditDelta:''};
+  }
+  function finish(){
+    const answerDelta=pending;
+    answer+=pending;pending='';
+    const cleanAnswer=answer.trim(),cleanAudit=editorialAudit.trim();
+    return {answer:cleanAnswer,editorialAudit:cleanAudit,auditMissing:!cleanAudit,
+      answerDelta};
+  }
+  return {take,finish};
+}
+
+export function splitSections(text){
+  const parser=createSectionSplitter();parser.take(text);return parser.finish();
+}
