+const data={revision:'r',estatico:{raices:[{id:'a',label:'A',categoria:{gr:'ποιεῖν',label:'hacer',voz:'nuestra'},hijos:[{id:'logos',label:'Lógos',sentidos:[{id:'razon',label:'Razón',ref:'1098a7'}],hijos:[{id:'detalle',rel:'parte',hijos:[{id:'ultimo',rel:'especie'}]}]}]},{id:'b',label:'B',hijos:[{id:'arete',rel:'especie'}]}]},funcional:{categorias:[{id:'1',hijos:[{id:'logos'},{id:'virtud',remite_a:['logos#razon'],hijos:[{id:'otro'}]}]}],aristas:[{id:'ar',de:'virtud',a:'logos',rel:'fin',voz:'nuestra',ref:'1098a7'}]},tags:{parrafos:[{parrafo:2,conceptos:[{c:'logos',s:'razon',n:'central',ref:'1098a7'},{c:'logos',s:'razon',n:'central',ref:'1098a8'}]}],unidades:[{id:'u',subunidades:[{id:'s',bekker:['1098a7','1098a8'],conceptos_clave:['logos']}]}],faqs:[{id:'q',pregunta:'¿Qué es la razón?',arbol:{nodo:'logos'},tambien:[{nodo:'virtud'}]},{id:'missing',arbol:{nodo:'no'}}]}};
+const g=buildTagTrees(data), names=TREE_LAYERS.map(([id])=>id);
+const staticIds=p=>p.nodes.map(n=>n.uid);
+test('vista esencial incluye raíces y nivel inmediato; profundidad es independiente de las capas',()=>{const p=layeredTree(g,'estatico');assert(staticIds(p).includes('estatico:logos'));assert(!staticIds(p).includes('estatico:detalle'));assert.equal(maxTreeDepth(g,'estatico'),3);assert(!staticIds(layeredTree(g,'estatico',{depth:3,layers:ESSENTIAL})).includes('estatico:detalle'));assert(staticIds(layeredTree(g,'estatico',{depth:3,layers:HIERARCHY})).includes('estatico:ultimo'));});
+test('rama seleccionada excluye otras raíces; ocultar padre no inventa una conexión al abuelo',()=>{const p=layeredTree(g,'estatico',{depth:3,root:'estatico:a',layers:['deep']});assert.deepEqual(staticIds(p),['estatico:detalle','estatico:ultimo']);assert.equal(p.edges.length,1);assert.equal(p.edges[0].hacia,'estatico:detalle');assert(!p.edges.some(e=>e.hacia==='estatico:a'));});
+test('aristas funcionales son opcionales y retienen dirección, tipo, voz y referencia',()=>{const p=layeredTree(g,'funcional',{layers:HIERARCHY});const edge=p.edges.find(e=>e.tipo==='arista_funcional');assert.equal(edge.desde,'funcional:virtud');assert.equal(edge.hacia,'funcional:logos');assert.equal(edge.ref,'1098a7');assert.equal(edge.voz,'nuestra');assert(!layeredTree(g,'funcional',{layers:['roots','main']}).edges.some(e=>e.tipo==='arista_funcional'));});
+test('sentidos y remisiones son registros explícitos; la referencia a un sentido lleva al sentido exacto',()=>{const p=layeredTree(g,'funcional',{layers:['roots','main','refs']});const s=p.nodes.find(n=>n.tipo==='sentido_registrado');assert.equal(s.id,'razon');assert(p.nodes.find(n=>n.uid==='estatico:logos').context);const r=p.edges.find(e=>e.tipo==='remision_editorial');assert.equal(r.desde,'funcional:virtud');assert.equal(r.hacia,s.uid);assert.equal(r.sentido,'razon');assert(!p.edges.some(e=>e.tipo==='identidad'));});
+test('tags directos mantienen granularidad y registros repetidos de procedencia distinta',()=>{const p=layeredTree(g,'estatico',{layers:['roots','main','docs']});const ds=p.edges.filter(e=>e.tipo==='tag_parrafo');assert.equal(ds.length,2);assert.deepEqual(ds.map(e=>e.ref),['1098a7','1098a8']);assert.equal(p.edges.filter(e=>e.tipo==='tag_subunidad').length,1);assert.equal(p.nodes.filter(n=>n.tipo==='parrafo_documental').length,1);assert(!layeredTree(g,'funcional',{layers:names}).edges.some(e=>e.tipo==='tag_parrafo'));});
+test('FAQ usa anclajes funcionales explícitos y no crea nodo de una referencia inexistente',()=>{const p=layeredTree(g,'funcional',{layers:['roots','main','faqs'],faqs:data.tags.faqs});assert.equal(p.nodes.filter(n=>n.tipo==='faq_editorial').length,1);assert.deepEqual(p.edges.filter(e=>e.tipo==='foco_faq').map(e=>e.label),['foco principal','también']);assert(!p.nodes.some(n=>n.id==='missing'));});
+test('todas las combinaciones de capas, profundidades y árboles conservan extremos y coordenadas; catálogo intacto',()=>{const before=JSON.stringify(g);for(const tree of ['estatico','funcional'])for(let d=0;d<=maxTreeDepth(g,tree);d++)for(let mask=0;mask<256;mask++){const p=layeredTree(g,tree,{depth:d,layers:names.filter((_,i)=>mask&(1<<i)),faqs:data.tags.faqs});const els=layeredElements(p),ns=els.filter(e=>e.group==='nodes'),ids=new Set(ns.map(e=>e.data.id));assert.equal(ids.size,ns.length);assert(ns.every(n=>Number.isFinite(n.position.x)&&Number.isFinite(n.position.y)));assert(els.filter(e=>e.group==='edges').every(e=>ids.has(e.data.source)&&ids.has(e.data.target)));}assert.equal(JSON.stringify(g),before);});
