+const get=async(url,signal,json=true)=>{const r=await fetch(url,{cache:'no-store',signal});if(!r.ok)throw Error(`${url}: HTTP ${r.status}`);return json?r.json():r.arrayBuffer();};
+const hash=async raw=>globalThis.crypto?.subtle?Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',raw)),b=>b.toString(16).padStart(2,'0')).join(''):null;
+const manifest=m=>`<p><b>${esc(m.concepto)}${m.sentido?' #'+esc(m.sentido):''}</b>${m.sentido_candidato?' · candidato #'+esc(m.sentido_candidato):''} · ${m.expreso?'expreso':'implícito'}</p><p>${esc(m.determinacion)}</p>`;
+function rowHtml(row,check){return `<article class="nuc-card"><h3>${esc(row.n.id)} · ${esc(row.n.unidad)}</h3><p>${esc(row.n.formulacion)}</p><small>${esc(row.n.voz)} · ${esc(row.n.estado)}</small>${row.m?manifest(row.m):''}${row.relacion?`${manifest(row.a)}<p><b>${esc(row.relacion.rel)}</b> → ${esc(row.relacion.familia)} · ${esc(row.relacion.voz)} · ${esc(row.relacion.estado)}</p>${manifest(row.b)}<p>${esc(row.relacion.justificacion)}</p>`:''}${row.transicion?`<p><b>Continuación editorial (no deducción):</b> ${esc(row.transicion.pregunta)}</p><p>${esc(row.s.id)} · ${esc(row.s.formulacion)}</p><p>${esc(row.transicion.justificacion)}</p>${row.nota_editorial?`<p><small>${esc(row.nota_editorial.movimiento)}: ${esc(row.nota_editorial.nota)}</small></p>`:''}`:''}<details><summary>Límites y evidencias</summary><p>${esc(row.n.limite)}</p>${row.s?`<p>${esc(row.s.limite)}</p>`:''}${[...row.evidencias,...(row.evidencias_destino||[])].map(e=>{const p=check.paragraphs.get(e.parrafo_local);return `<details><summary>${esc(e.uid)} · EN I · ${esc(e.subunidad)} · §${esc(e.parrafo_local)}</summary><p lang="grc">${esc(e.gr_ancla)}</p><p>Contexto bilingüe del párrafo completo:</p><p>${esc(p.es)}</p><p lang="grc">${esc(p.gr)}</p></details>`}).join('')}</details></article>`;}
+export function createLabSemanticQueryView(){
+ const el=document.createElement('div');el.className='scrollable has-scroll nuc-view';const abort=new AbortController();let disposed=false,data=null,result=null;
+ if(!document.querySelector('link[data-nuclei-styles]')){const css=document.createElement('link');css.rel='stylesheet';css.href='/css/lab-nuclei-n1u1935c.css';css.dataset.nucleiStyles='1';document.head.appendChild(css);}
+ el.innerHTML=`<main class="nuc-inner"><nav><a href="#/lab">← Laboratorio</a> · <a href="#/lab/nucleos">Articulaciones semánticas</a></nav><h1>Consultas semánticas · N1-U.19.3.6a</h1><p>Subconjunto de Cypher de solo lectura. No ejecuta consultas externas ni llama a un LLM. Conserva las voces y los estados editoriales.</p><p data-status role="status">Cargando datos activos…</p><section class="nuc-card"><label>Ejemplos <select data-example>${SEMANTIC_EXAMPLES.map(([name],i)=>`<option value="${i}">${esc(name)}</option>`).join('')}</select></label><p><label>Patrón de consulta<br><textarea data-query rows="5" maxlength="1500" spellcheck="false" style="width:100%">${esc(SEMANTIC_EXAMPLES[0][1])}</textarea></label></p><button type="button" data-run disabled>Consultar</button><p role="alert" data-error></p></section><section data-results aria-live="polite"></section><section class="nuc-card"><h2>Contexto para el futuro diálogo</h2><p>Expediente JSON verificable, no respuesta generada. No se envía a OpenRouter; se exporta para revisión.</p><label>Pregunta del interlocutor (opcional)<textarea data-question rows="3" maxlength="1000" style="width:100%"></textarea></label><button type="button" data-export disabled>Exportar contexto JSON</button><p role="status" data-export-status></p></section></main>`;
+ const $=s=>el.querySelector(s);const reset=()=>{result=null;$('[data-results]').innerHTML='';$('[data-export]').disabled=true;$('[data-error]').textContent='';$('[data-export-status]').textContent='';};
+ $('[data-example]').addEventListener('change',e=>{$('[data-query]').value=SEMANTIC_EXAMPLES[Number(e.target.value)][1];reset();});
+ $('[data-query]').addEventListener('input',reset);
