@@ -0,0 +1,84 @@
+// Capa de presentación: agrupa FAQ que comparten el mismo concepto de foco.
+// No inventa aristas editoriales ni modifica el grafo subyacente.
+export const TIPOS_VISIBLES = Object.freeze([
+  ['concepto_estatico', 'Conceptos estáticos'],
+  ['nodo_funcional', 'Nodos funcionales propios'],
+  ['faq', 'Preguntas FAQ'],
+  ['unidad', 'Unidades'],
+  ['definicion', 'Definiciones'],
+]);
+
+export function estadoTiposInicial() {
+  return Object.fromEntries(TIPOS_VISIBLES.map(([tipo]) => [tipo, true]));
+}
+
+export function normalizarTiposVisibles(value) {
+  const defaults = estadoTiposInicial();
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return defaults;
+  for (const key of Object.keys(defaults)) if (typeof value[key] === 'boolean') defaults[key] = value[key];
+  return defaults;
+}
+
+// Identidad determinista del grupo: depende solo del concepto receptor.
+export function idGrupoFaq(concepto) {
+  return `grupo_faq:${concepto}`;
+}
+
+export function agruparFaqs(elementos, { expandidos = new Set(), tiposVisibles = estadoTiposInicial(), focos = [] } = {}) {
+  const focus = new Set(focos);
+  const visibles = normalizarTiposVisibles(tiposVisibles);
+  const nodos = elementos.filter(el => el.group === 'nodes');
+  const aristas = elementos.filter(el => el.group === 'edges');
+  const byId = new Map(nodos.map(n => [n.data.id, n]));
+  const ocultos = new Set(nodos.filter(n => !focus.has(n.data.id) && visibles[n.data.tipo] === false).map(n => n.data.id));
+  const candidatas = new Map();
+  for (const a of aristas) {
+    const d = a.data;
+    if (d.tipo !== 'foco_faq') continue;
+    const faq = byId.get(d.source)?.data.tipo === 'faq' ? d.source
+      : byId.get(d.target)?.data.tipo === 'faq' ? d.target : null;
+    if (!faq || ocultos.has(faq) || focus.has(faq)) continue;
+    const concepto = d.source === faq ? d.target : d.source;
+    if (!byId.has(concepto) || ocultos.has(concepto)) continue;
+    const entries = candidatas.get(concepto) || new Set();
+    entries.add(faq);
+    candidatas.set(concepto, entries);
+  }
+  const grupos = [];
+  const faqReemplazadas = new Set();
+  const edgesReemplazadas = new Set();
+  const adicionales = [];
+  for (const [concepto, faqs] of candidatas) {
+    if (faqs.size < 2) continue;
+    const id = idGrupoFaq(concepto);
+    const miembros = [...faqs].sort();
+    grupos.push({ id, concepto, miembros, expandido: expandidos.has(id) });
+    if (!expandidos.has(id)) for (const faq of miembros) faqReemplazadas.add(faq);
+    adicionales.push({ group: 'nodes', data: {
+      id, tipo: 'grupo_faq', label: `FAQ (${miembros.length})`,
+      resumen: 1, agrupadorFaq: 1, concepto, cantidad: miembros.length,
+      miembros: miembros.join(', '),
+    } });
+    // Este enlace representa el conjunto visual; no se identifica como relación del corpus.
+    adicionales.push({ group: 'edges', data: {
+      id: `enlace:${id}`, source: id, target: concepto, tipo: 'agrupacion_visual',
+      label: '', relacion: '', fuente: 'presentacion', agrupacionVisual: 1,
+    } });
+  }
+  for (const edge of aristas) {
+    if (faqReemplazadas.has(edge.data.source) || faqReemplazadas.has(edge.data.target)) {
+      edgesReemplazadas.add(edge.data.id);
+    }
+  }
+  const outNodes = nodos.filter(n => !ocultos.has(n.data.id) && !faqReemplazadas.has(n.data.id));
+  const outIds = new Set([...outNodes, ...adicionales.filter(x => x.group === 'nodes')].map(x => x.data.id));
+  const outEdges = aristas.filter(e => !edgesReemplazadas.has(e.data.id) &&
+    outIds.has(e.data.source) && outIds.has(e.data.target));
+  return {
+    elementos: [...outNodes, ...adicionales.filter(e => e.group === 'nodes'), ...outEdges,
+      ...adicionales.filter(e => e.group === 'edges')],
+    grupos,
+    ocultos: ocultos.size,
+    agrupadas: faqReemplazadas.size,
+  };
+}
