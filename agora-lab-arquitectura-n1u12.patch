+// N1-U.12 · Preferencias legibles y expansión documental sin escribir MariaDB.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import { construirModeloArquitectura } from '../js/lab/architectureModel.js';
+import { construirRelacionesProemio } from '../js/lab/architectureRelations.js';
+import { construirCapasProemio } from '../js/lab/architectureLayers.js';
+import { construirFichasArquitectura } from '../js/lab/architectureCards.js';
+import { construirPuentesExplicativos } from '../js/lab/architectureBridges.js';
+import { construirAmpliacionFichas } from '../js/lab/architecturePilotNetwork.js';
+import { cargarDisplay, guardarDisplay, normalizarDisplay, variarFuente, proyectarRamasEstructurales, hijosEstructurales, DEFAULT_DISPLAY } from '../js/lab/architectureDisplay.js';
+import { elementosContextoEstructural } from '../js/lab/architectureStructuralContext.js';
+const read = p => JSON.parse(fs.readFileSync(new URL(p,import.meta.url),'utf8'));
+const snap = read('./fixtures/n1u2-unidades.json');
+const original = JSON.stringify(snap);
+const model = construirModeloArquitectura(snap,read('../lab/n1u1-propuestas-libro-i.json'));
+const rels = construirRelacionesProemio(model,read('../lab/n1u3-relaciones-proemio.json'));
+const capas = construirCapasProemio(model,rels,read('../lab/n1u4-modulos-proemio.json'));
+const base = construirFichasArquitectura(model,capas,read('../lab/n1u5-fichas-explicativas.json'));
+const bridges = construirPuentesExplicativos(model,base,read('../lab/n1u6-puentes-explicativos.json'));
+const {fichas,puentes} = construirAmpliacionFichas(model,base,bridges,read('../lab/n1u7-fichas-red-piloto.json'));
+for (const ficha of fichas.fichas) {
+  const els = elementosContextoEstructural(model,fichas,puentes,ficha.id);
+  const copy = JSON.stringify(els), ids = new Set(els.filter(e=>e.group==='nodes').map(e=>e.data.id));
+  const collapsed = new Set([`puente:ficha:${ficha.id}`]);
+  const onlyRoot = proyectarRamasEstructurales(els,collapsed);
+  assert.equal(onlyRoot.filter(e=>e.group==='nodes').length,1);
+  assert.equal(onlyRoot.filter(e=>e.group==='edges').length,0);
+  assert.equal(onlyRoot[0].data.colapsado,1);
+  assert(onlyRoot[0].data.label.endsWith('[+]'));
+  assert.deepEqual(proyectarRamasEstructurales(els,new Set()).map(e=>e.data.id),els.map(e=>e.data.id));
+  const firstMacro = els.find(e=>e.group==='nodes'&&e.data.tipo==='macro_referida');
+  assert(firstMacro);
+  const pruned = proyectarRamasEstructurales(els,new Set([firstMacro.data.id]));
+  assert(pruned.filter(e=>e.group==='nodes').length < els.filter(e=>e.group==='nodes').length);
+  assert(pruned.some(e=>e.data.id===firstMacro.data.id),'la rama contraída conserva su raíz');
+  for(const e of pruned.filter(e=>e.group==='edges')) assert(pruned.some(n=>n.group==='nodes'&&n.data.id===e.data.source)&&pruned.some(n=>n.group==='nodes'&&n.data.id===e.data.target));
+  const children=hijosEstructurales(els); assert(children.has(`puente:ficha:${ficha.id}`));
+  assert.equal(ids.size,els.filter(e=>e.group==='nodes').length);
+  assert.equal(JSON.stringify(els),copy,'la proyección no modifica los datos editoriales');
+}
+assert.deepEqual(normalizarDisplay({readerFont:999,graphFont:-1,showEdgeNames:'false'}),DEFAULT_DISPLAY);
+assert.equal(variarFuente(DEFAULT_DISPLAY,'readerFont',200).readerFont,30);
+assert.equal(variarFuente(DEFAULT_DISPLAY,'readerFont',-200).readerFont,14);
+assert.equal(variarFuente(DEFAULT_DISPLAY,'graphFont',200).graphFont,26);
+assert.equal(variarFuente(DEFAULT_DISPLAY,'graphFont',-200).graphFont,12);
+const store={data:new Map(),getItem(k){return this.data.get(k)||null;},setItem(k,v){this.data.set(k,v);}};
+assert.deepEqual(cargarDisplay(store),DEFAULT_DISPLAY);
+const next={readerFont:22,graphFont:20,showEdgeNames:false};
+assert.deepEqual(guardarDisplay(store,next),next);
+assert.deepEqual(cargarDisplay(store),next);
+store.data.set('agora.lab.arquitectura.lectura.v1','{invalido');
+assert.deepEqual(cargarDisplay(store),DEFAULT_DISPLAY);
+const view=fs.readFileSync(new URL('../js/views/labArchitectureView.js',import.meta.url),'utf8');
+const css=fs.readFileSync(new URL('../css/lab-arquitectura-n1u12.css',import.meta.url),'utf8');
+for (const x of ['data-arch-graph-font','data-arch-reader-font','data-arch-edge-labels','data-arch-toggle-branch','proyectarRamasEstructurales','cy.on(\'tap\', \'node\'','graphStyle(display)']) assert(view.includes(x),x);
+assert(view.includes('if (same && n.data(\'tieneHijos\') === 1)'));
+assert(css.includes('.arch-reader .reader-text') && css.includes('monospace'));
+assert.equal(JSON.stringify(snap),original,'la exportación de MariaDB permanece intacta');
+console.log('N1-U.12 OK · 7 respaldos selectivos · contracción reversible · preferencias locales de griego/castellano y Cytoscape · sin cambios canónicos.');
