+    const lastTurns=history.length?`ANTECEDENTES CONVERSACIONALES (no son citas):\n${history.map(h=>`Pregunta anterior: ${h.question}\nRespuesta anterior: ${h.answer}`).join('\n')}\n\n`:'';
+    const focus=mode==='contraste'
+      ? 'Evaluá críticamente la interpretación, distinguiendo citas pertinentes, límites de la evidencia y posibles lecturas alternativas. No afirmes apoyo u oposición sin argumentarlo.'
