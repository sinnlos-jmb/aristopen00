+import {inspectNuclei,continuations,anchorMarkup} from '../lab/semanticNuclei.js';
+import {controlesTamanoLector,actualizarLectura,cambiarTamanoLector} from '../reader/fontPreferences.js';
+const get=async(url,signal,json=true)=>{const r=await fetch(url,{cache:'no-store',signal});if(!r.ok)throw Error(`${url}: HTTP ${r.status}`);return json?r.json():r.text();};
+const button=(id,label,attr='data-nucleus')=>`<button type="button" ${attr}="${esc(id)}">${esc(label)}</button>`;
+const labels={n01:'Actividad y obra',n02:'Función humana',n03:'Excelencia',n04:'Bien humano',n05:'Posesión y ejercicio',n06:'Fin por sí mismo',n07:'Disposición elogiable',n08:'Fortuna',n09:'Vida mortal',n10:'Aprendizaje y cultivo'};
+const title=id=>labels[id]||id;
+export function createLabNucleiView(){
+ const el=document.createElement('div');el.className='scrollable has-scroll nuc-view';const controller=new AbortController();let destroyed=false,pilot,check,revision,route,history=[],inventory=false;
+ if(!document.querySelector('link[data-nuclei-styles]')){const css=document.createElement('link');css.rel='stylesheet';css.href='/css/lab-nuclei-n1u1935c.css';css.dataset.nucleiStyles='1';document.head.appendChild(css);}
+ const shell=body=>`<main class="nuc-inner"><nav><a href="#/lab">← Laboratorio</a> · N1-U.19.3.5c</nav>${controlesTamanoLector()}<h1>Articulaciones semánticas</h1>${body}</main>`;
+ el.innerHTML=shell('<p>Cargando catálogo piloto y texto activo…</p>');
+ function render(){if(destroyed)return;const id=history.at(-1),n=check.nodes.get(id),r=pilot.recorridos.find(x=>x.id===route),previous=history.at(-2),transition=check.transitions.get(`${previous}/${id}`);const unresolved=check.issues.filter(x=>x.id===id);const status=check.issues.length?`${check.issues.length} incidencias; revisar antes de reutilizar.`:'Referencias y anclas de párrafo comprobadas en los datos activos.';
+ const evid=n.evidencias.map((e,i)=>{const p=check.paragraphs.get(e.parrafo_local);return `<details><summary>${esc(e.obra)} I · ${esc(e.subunidad)} · §${esc(e.parrafo_local)} · ancla ${i+1}</summary><p lang="grc">${esc(e.gr_ancla)}</p>${p?`<p class="nuc-note">Párrafo bilingüe completo (no traducción aislada del ancla).</p><div class="nuc-bilingual"><p>${esc(p.es)}</p><p lang="grc">${anchorMarkup(p.gr,e.gr_ancla,esc)}</p></div>`:'<p>Párrafo no disponible.</p>'}</details>`;}).join('');
