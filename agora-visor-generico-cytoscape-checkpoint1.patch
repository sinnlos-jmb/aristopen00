+// Único renderer, reutilizable con CUALQUIER colección de elementos Cytoscape.
+import { cargarCytoscape } from './cytoscapeLoader.js';
+
+export async function crearVisorGrafo(contenedor, elementos, { agrupado = false, alSeleccionar = () => {}, alOcultar = () => {} } = {}) {
+  const cytoscape = await cargarCytoscape();
+  const cy = cytoscape({
+    container: contenedor,
+    elements: elementos,
+    wheelSensitivity: 0.23,
+    minZoom: 0.12,
+    maxZoom: 3.5,
+    layout: agrupado
+      ? { name: 'circle', animate: false, padding: 35 }
+      : { name: 'cose', animate: false, randomize: true, numIter: 450, nodeRepulsion: () => 260000,
+          idealEdgeLength: () => 100, padding: 45 },
+    style: [
+      { selector: 'node', style: {
+        'background-color': '#dce7ec', 'border-color': '#7193a6', 'border-width': 1.3,
+        'label': 'data(label)', 'color': '#24394a', 'font-size': agrupado ? 12 : 9,
+        'text-wrap': 'ellipsis', 'text-max-width': agrupado ? 140 : 95,
+        'text-valign': 'center', 'text-halign': 'center',
+        'width': agrupado ? 138 : 76, 'height': agrupado ? 54 : 34,
+        'shape': 'round-rectangle', 'text-outline-width': 0,
+      } },
+      { selector: 'node[tipo = "nodo_funcional"]', style: { 'background-color': '#d5eadf' } },
+      { selector: 'node[tipo = "faq"]', style: { 'background-color': '#f4e6bf' } },
+      { selector: 'node[tipo = "subunidad"]', style: { 'background-color': '#e4dcf0' } },
+      { selector: 'edge', style: {
+        'curve-style': 'bezier', 'width': 1.2, 'line-color': '#99a8b5',
+        'target-arrow-shape': 'triangle', 'target-arrow-color': '#99a8b5',
+        'arrow-scale': 0.7, 'opacity': 0.75,
+      } },
+      { selector: ':selected', style: {
+        'border-color': '#b36d20', 'border-width': 3, 'line-color': '#b36d20',
+        'target-arrow-color': '#b36d20', 'opacity': 1,
+      } },
+    ],
+  });
+  let previous = { id: null, at: 0 };
+  cy.on('tap', 'node', evt => {
+    const item = evt.target;
+    const now = Date.now();
+    // El doble toque/clic oculta sólo la instancia visual, jamás el corpus.
+    if (item.id() === previous.id && now - previous.at < 340) {
+      item.hide(); previous = { id: null, at: 0 }; alOcultar(item.data()); return;
+    }
+    previous = { id: item.id(), at: now };
+    alSeleccionar({ clase: 'nodo', ...item.data() });
+  });
+  cy.on('tap', 'edge', evt => alSeleccionar({ clase: 'arista', ...evt.target.data() }));
+  cy.on('tap', evt => { if (evt.target === cy) alSeleccionar(null); });
+  return {
+    cy,
+    enfocar(id) {
+      const node = cy.getElementById(id);
+      if (node.empty()) return false;
+      node.show(); node.select(); cy.animate({ center: { eles: node }, zoom: Math.max(cy.zoom(), 1) }, { duration: 250 });
+      alSeleccionar({ clase: 'nodo', ...node.data() });
+      return true;
+    },
+    ocultarSeleccion() { const s = cy.$(':selected'); s.hide(); alOcultar(null); },
+    restaurar() { cy.elements().show(); },
+    ajustar() { cy.fit(undefined, 35); },
+    destruir() { cy.destroy(); },
+  };
+}
diff --git a/public/js/views/labGraphPilotView.js b/public/js/views/labGraphPilotView.js
new file mode 100644
--- /dev/null
+++ b/public/js/views/labGraphPilotView.js
@@ -0,0 +1,111 @@
+import { esc } from '../ui.js';
+import { buildSemanticProjection, buscarNodosSemanticos } from '../lab/semanticProjection.js';
+import { proyeccionAElementos, resumenClasesAElementos, estadisticasElementos } from '../lab/semanticGraphAdapter.js';
+import { crearVisorGrafo } from '../lab/cytoscapeRenderer.js';
+
+// Checkpoint 1: un visor genérico; todavía no modifica el Orientador ni las valoraciones didácticas.
+export function createLabGraphPilotView(App) {
+  const el = document.createElement('div');
+  el.className = 'view-lab scrollable has-scroll';
+  const projection = buildSemanticProjection(App?.S || {});
+  let modo = 'grupos';
+  let tipo = 'todos';
+  let viewer = null;
+  let closed = false;
+  let generation = 0;
+  const kinds = Object.keys(projection.stats.porTipo);
+  el.innerHTML = `<div class="lab__inner">
+    <nav class="lab-nav"><a class="btn btn--ghost btn--sm" href="#/lab">← Laboratorio</a></nav>
+    <header class="lab-exp__header"><h1 class="lab-exp__title">Visor genérico de grafos · Checkpoint 1</h1></header>
+    <section class="lab-card">
+      <h2>Inventario y exploración libre</h2>
+      <p class="hint">Copia de lectura del corpus: ${projection.stats.nodos} nodos, ${projection.stats.aristas} vínculos, ${projection.issues.length} incidencias. La dirección de las flechas representa la orientación documental; no implica causalidad.</p>
+      <div class="lab-toolbar">
+        <button id="gv-mode" type="button" class="lab-btn">Mostrar universo completo</button>
+        <label for="gv-kind">Tipo de nodo</label>
+        <select id="gv-kind" class="lab-input"><option value="todos">Todos</option>${kinds.map(k => `<option value="${esc(k)}">${esc(k.replaceAll('_',' '))}</option>`).join('')}</select>
+        <button id="gv-fit" type="button" class="lab-btn lab-btn--ghost">Ajustar vista</button>
+        <button id="gv-hide" type="button" class="lab-btn lab-btn--ghost">Ocultar selección</button>
+        <button id="gv-restore" type="button" class="lab-btn lab-btn--ghost">Restaurar ocultos</button>
+      </div>
+      <form id="gv-search-form" class="lab-form">
+        <label for="gv-search">Buscar y enfocar nodo</label>
+        <input id="gv-search" class="lab-input" type="search" placeholder="phusis, arete, eudaimonia…" />
+        <button type="submit" class="lab-btn">Encontrar</button>
+      </form>
+      <div id="gv-matches" class="lab-help"></div>
+      <p class="hint">Arrastrá un nodo para desplazarlo. Arrastrá el fondo para mover el grafo. Rueda para zoom. Clic para inspeccionar; doble clic para ocultar un nodo. Eliminar de la vista no modifica el corpus.</p>
+      <div id="gv-canvas" class="lab-graph-canvas" role="region" aria-label="Grafo interactivo de Ágora"></div>
+      <p id="gv-status" role="status" class="hint">Preparando el visualizador…</p>
+      <section id="gv-inspector" class="lab-panel" aria-label="Detalles de la selección"><h3>Selección</h3><p>Seleccioná un nodo o una arista para examinar sus propiedades.</p></section>
+    </section></div>`;
+  const $ = sel => el.querySelector(sel);
+  const status = text => { if (!closed) $('#gv-status').textContent = text; };
+  function inspeccionar(item) {
+    if (closed) return;
+    const out = $('#gv-inspector');
+    if (!item) { out.innerHTML = '<h3>Selección</h3><p>Seleccioná un nodo o arista.</p>'; return; }
+    // No se serializan datos ajenos al corpus como HTML ejecutable.
+    const attrs = Object.entries(item).filter(([k,v]) => !['id','label','clase'].includes(k) && v != null && v !== '');
+    out.innerHTML = `<h3>${esc(item.label || item.tipo || item.clase)}</h3><p><strong>ID:</strong> ${esc(item.id || '—')} · ${esc(item.clase)}</p><dl class="lab-graph-properties">${attrs.map(([k,v]) => `<dt>${esc(k)}</dt><dd>${esc(String(v))}</dd>`).join('')}</dl>`;
+    if (item.clase === 'nodo' && item.resumen) {
+      const button = document.createElement('button');
+      button.type = 'button'; button.className = 'lab-btn lab-btn--ghost';
+      button.textContent = `Explorar sólo ${item.tipo}`;
+      button.addEventListener('click', () => { modo = 'todo'; tipo = item.tipo; $('#gv-kind').value = tipo; dibujar(); });
+      out.append(button);
+    }
+  }
+  async function dibujar() {
+    const ticket = ++generation;
+    viewer?.destruir(); viewer = null;
+    $('#gv-canvas').replaceChildren();
+    const agrupado = modo === 'grupos';
+    const elements = agrupado ? resumenClasesAElementos(projection)
+      : proyeccionAElementos(projection, { tipos: tipo === 'todos' ? null : [tipo] });
+    const stats = estadisticasElementos(elements);
+    $('#gv-mode').textContent = agrupado ? 'Mostrar universo completo' : 'Vista por categorías';
+    $('#gv-kind').disabled = agrupado;
+    status(`Cargando ${stats.nodos} nodos y ${stats.aristas} vínculos…`);
+    try {
+      const instance = await crearVisorGrafo($('#gv-canvas'), elements, {
+        agrupado,
+        alSeleccionar: inspeccionar,
+        alOcultar: () => status('Nodo ocultado sólo en esta vista. Podés restaurarlo.'),
+      });
+      if (closed || ticket !== generation) { instance.destruir(); return; }
+      viewer = instance;
+      status(`${stats.nodos} nodos · ${stats.aristas} vínculos visibles inicialmente. ${agrupado ? 'Vista agregada por tipos, no por conceptos.' : 'Universo documental; se conservan las aristas originales.'}`);
+    } catch (error) {
+      if (closed || ticket !== generation) return;
+      status(`No se pudo cargar el visor: ${error.message}`);
+    }
+  }
+  $('#gv-mode').addEventListener('click', () => { modo = modo === 'grupos' ? 'todo' : 'grupos'; tipo = 'todos'; $('#gv-kind').value = tipo; dibujar(); });
+  $('#gv-kind').addEventListener('change', e => { tipo = e.target.value; dibujar(); });
+  $('#gv-fit').addEventListener('click', () => viewer?.ajustar());
+  $('#gv-hide').addEventListener('click', () => { viewer?.ocultarSeleccion(); status('Selección ocultada en la vista.'); });
+  $('#gv-restore').addEventListener('click', () => { viewer?.restaurar(); status('Elementos restaurados.'); });
+  $('#gv-search-form').addEventListener('submit', e => {
+    e.preventDefault();
+    const term = $('#gv-search').value.trim();
+    const matches = buscarNodosSemanticos(projection, term, 20);
+    $('#gv-matches').innerHTML = matches.map(n => `<button class="lab-help__item" type="button" data-gv-target="${esc(n.uid)}">${esc(n.etiqueta)} · ${esc(n.tipo)}</button>`).join('') || '<p class="hint">Sin coincidencias.</p>';
+  });
+  $('#gv-matches').addEventListener('click', async e => {
+    const button = e.target.closest('[data-gv-target]');
+    if (!button || !el.contains(button)) return;
+    const id = button.dataset.gvTarget;
+    const node = projection.nodes.find(n => n.uid === id);
+    if (!node) return;
+    if (modo !== 'todo' || (tipo !== 'todos' && tipo !== node.tipo)) {
+      modo = 'todo'; tipo = 'todos'; $('#gv-kind').value = tipo;
+      await dibujar();
+    }
+    if (viewer?.enfocar(id)) status(`Foco visual: ${node.etiqueta} (${node.uid}).`);
+  });
+  // El router monta la vista después de invocar esta factory. Dibujar con el contenedor ya visible.
+  if (typeof requestAnimationFrame === 'function') requestAnimationFrame(() => { if (!closed) void dibujar(); });
+  else setTimeout(() => { if (!closed) void dibujar(); }, 0);
+  return { el, destroy() { closed = true; ++generation; viewer?.destruir(); viewer = null; } };
+}
