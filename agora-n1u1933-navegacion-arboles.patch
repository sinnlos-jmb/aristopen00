+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {buildTagTrees} from '../js/lab/tagTreesGraph.js';
+import {layeredTree,layeredElements,ESSENTIAL} from '../js/lab/tagTreeLayers.js';
+import {hierarchyIndex,toggleTreeBranch,newTreeLayout,captureTreeLayout,positionTreeElements,exportTreeLayouts,syncTreeElements,TREE_WHEEL_SENSITIVITY} from '../js/lab/tagTreeNavigation.js';
+const graph=buildTagTrees({revision:'r',estatico:{raices:[{id:'a',hijos:[{id:'b',hijos:[{id:'c',hijos:[{id:'d',hijos:[{id:'e'}]}]}]},{id:'x',hijos:[{id:'y'}]}]}]},funcional:{categorias:[{id:'f',hijos:[{id:'b',hijos:[{id:'c'}]}]}],aristas:[{de:'b',a:'c',rel:'test'}]},tags:{}});
+const pref=()=>({layers:new Set(ESSENTIAL),depth:1,root:'',span:2,branches:new Map()});
+const view=(p,t='estatico')=>layeredTree(graph,t,p);
+const ids=p=>new Set(p.nodes.map(n=>n.uid));
+test('doble clic abre dos generaciones locales, contrae y permite reabrir; no altera otras ramas',()=>{const p=pref(),i=hierarchyIndex(graph,'estatico');assert(toggleTreeBranch(i,p,'estatico:b',ids(view(p))));assert.deepEqual([...ids(view(p))],['estatico:a','estatico:b','estatico:c','estatico:d','estatico:x']);assert(toggleTreeBranch(i,p,'estatico:b',ids(view(p))));assert.deepEqual([...ids(view(p))],['estatico:a','estatico:b','estatico:x']);assert(toggleTreeBranch(i,p,'estatico:b',ids(view(p))));assert(ids(view(p)).has('estatico:d'));});
+test('colapsar ancestro retira expansión interna incluso en vista completa; profundidad y capas respetadas',()=>{const p=pref(),i=hierarchyIndex(graph,'estatico');p.depth=4;p.layers.add('deep');toggleTreeBranch(i,p,'estatico:c',ids(view(p)));assert(!ids(view(p)).has('estatico:d'));toggleTreeBranch(i,p,'estatico:b',ids(view(p)));assert(ids(view(p)).has('estatico:d'));toggleTreeBranch(i,p,'estatico:b',ids(view(p)));assert(!ids(view(p)).has('estatico:c'));p.layers.delete('deep');assert(!ids(view(p)).has('estatico:y'));assert.equal(toggleTreeBranch(i,p,'estatico:e',ids(view(p))),false);});
+test('arista funcional no se vuelve relación padre-hijo; estados separados, extremos válidos',()=>{const p=pref(),i=hierarchyIndex(graph,'funcional');toggleTreeBranch(i,p,'funcional:b',ids(view(p,'funcional')));const v=view(p,'funcional');assert(ids(v).has('funcional:c'));assert(v.edges.some(e=>e.tipo==='arista_funcional'));assert(v.edges.every(e=>ids(v).has(e.desde)&&ids(v).has(e.hacia)));assert(!ids(view(pref())).has('estatico:c'));});
+test('posiciones manuales, ocultas y cámara se conservan; exportación contiene coordenadas',()=>{const p=pref(),l=newTreeLayout(),old=positionTreeElements(layeredElements(view(p)),l);const moved={x:910,y:220};captureTreeLayout(l,{nodes:()=>[{id:()=> 'estatico:b',position:()=>moved}],pan:()=>({x:10,y:20}),zoom:()=>.7});p.layers.add('deep');p.depth=4;const more=positionTreeElements(layeredElements(view(p)),l);assert.deepEqual(more.find(e=>e.data.id==='estatico:b').position,moved);p.layers.delete('main');positionTreeElements(layeredElements(view(p)),l);p.layers.add('main');assert.deepEqual(positionTreeElements(layeredElements(view(p)),l).find(e=>e.data.id==='estatico:b').position,moved);const result=JSON.parse(JSON.stringify(exportTreeLayouts('r',{estatico:l,funcional:newTreeLayout()},{estatico:p,funcional:pref()})));assert.deepEqual(result.trees.estatico.positions['estatico:b'],moved);assert.deepEqual(result.trees.estatico.camera,{pan:{x:10,y:20},zoom:.7});assert.equal(result.schema,'agora.tag-tree-layouts.v1');assert.equal(TREE_WHEEL_SENSITIVITY,1.8);assert(old.length>0);});
+test('sincronización incremental no recoloca nodos existentes ni elimina conexiones válidas',()=>{const p=pref(),l=newTreeLayout(),els=positionTreeElements(layeredElements(view(p)),l),m=new Map(),removed=[],added=[];const make=e=>({id:()=>e.data.id,length:1,data:()=>{},group:e.group,remove(){removed.push(e.data.id);m.delete(e.data.id);}});els.forEach(e=>m.set(e.data.id,make(e)));const cy={batch:f=>f(),nodes:()=>[...m.values()].filter(e=>e.group==='nodes'),edges:()=>[...m.values()].filter(e=>e.group==='edges'),getElementById:id=>m.get(id)||{length:0},add:xs=>xs.forEach(e=>{added.push(e.data.id);m.set(e.data.id,make(e));})};const existing=m.get('estatico:b');p.depth=2;p.layers.add('deep');syncTreeElements(cy,positionTreeElements(layeredElements(view(p)),l));assert.strictEqual(m.get('estatico:b'),existing);assert(added.includes('estatico:c'));assert(!removed.includes('estatico:b'));p.layers.delete('deep');syncTreeElements(cy,positionTreeElements(layeredElements(view(p)),l));assert(removed.includes('estatico:c'));assert.strictEqual(m.get('estatico:b'),existing);});
+test('vista conecta gestos, cámara, inspector y exportación de disposición',async()=>{const s=await readFile(new URL('../js/views/tagTreesPanel.js',import.meta.url),'utf8');for(const v of ['toggleTreeBranch','lastTap===id','syncTreeElements(cy,elements)','captureTreeLayout','restoreCamera','inspectEdge','data-tag-layout','data-tag-span','data-tag-zoom','download(graph)'])assert(s.includes(v));});
