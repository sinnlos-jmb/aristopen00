+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {REVIEW_CASES,TRANSITION_NOTES,inventoryFunctional,paragraphKey,reviewSnapshot,renderEditorialReview} from '../js/lab/semanticReview.js';
+const fixture=()=>{
+ const nodes=new Map();for(const [id,subunidad] of REVIEW_CASES){if(!nodes.has(id))nodes.set(id,{id,evidencias:[]});nodes.get(id).evidencias.push({obra:'EN',libro:1,parrafo_local:1,subunidad,gr_ancla:'<ancla>'});}
+ const changes=[['energeia_acto','energeia'],['energeia_actividad','energeia'],['ergon_obra','ergon'],['ergon_funcion','ergon']].map(([id,padre])=>({id,padre:'estatico:'+padre,actual:'especie',propuesta:'agrupacion'}));
+ const pilot={nucleos:[...nodes.values()],cambios_jerarquia:changes,propuestas_sentidos:[{concepto:'estatico:logos',id:'lenguaje',estado:'propuesto'}],transiciones:Object.keys(TRANSITION_NOTES).map(k=>{const [de,a]=k.split('/');return {de,a};}),familias_relacion:{orienta:'teleologica'}};
+ const concepts=new Map(changes.map(c=>['estatico:'+c.id,{parent:c.padre,source:{rel:'especie'}}]));concepts.set('estatico:logos',{source:{sentidos:[]}});
+ const check={concepts,issues:[],graph:{issues:[],edges:[{tipo:'arista_funcional',rel:'orienta',voz:'nuestra',ref:'EN I'},{tipo:'arista_funcional',rel:'orienta',voz:'textual',ref:''},{tipo:'jerarquia',rel:'especie'}]}};return {pilot,check};
+};
+test('clave documental distingue libros y rechaza identidad incompleta',()=>{assert.notEqual(paragraphKey({obra:'EN',libro:1,parrafo_local:1}),paragraphKey({obra:'EN',libro:2,parrafo_local:1}));assert.throws(()=>paragraphKey({obra:'EN',parrafo_local:1}));});
