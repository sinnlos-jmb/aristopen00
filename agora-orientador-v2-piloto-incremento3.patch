+  process.exitCode = 1;
+} else {
+  const sesiones = [];
+  for (const archivo of archivos) {
+    const valor = JSON.parse(readFileSync(archivo, 'utf8'));
+    if (Array.isArray(valor)) sesiones.push(...valor);
+    else sesiones.push(valor);
+  }
