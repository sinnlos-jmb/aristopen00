index 0000000..b7c4b67
--- /dev/null
+++ b/public/js/lab/llmGraphView.js
@@ -0,0 +1,28 @@
+import { esc } from '../ui.js';
+// Vista del recorrido ejecutado, no un grafo inferido por la respuesta de IA.
+export function renderLLMGraph(trace){
+  if(!trace)return '';
+  const nodes=Array.isArray(trace.nodes)?trace.nodes:[], edges=Array.isArray(trace.edges)?trace.edges:[], steps=Array.isArray(trace.steps)?trace.steps:[];
+  const fichas=nodes.filter(n=>n.type==='ficha');
+  const passages=nodes.filter(n=>n.type==='pasaje');
+  const positions=new Map();
+  fichas.forEach((n,i)=>positions.set(n.id,{x:12,y:18+i*54,w:220,h:42}));
+  passages.forEach((n,i)=>positions.set(n.id,{x:360+(i%2)*160,y:18+Math.floor(i/2)*48,w:150,h:35}));
+  const height=Math.max(100,fichas.length*54+25,Math.ceil(passages.length/2)*48+25);
+  const nodeHtml=(n,i)=>{const p=positions.get(n.id);if(!p)return '';
+    const label=n.type==='ficha'?String(n.title):String(n.reference||n.title);
+    const shape=`<rect x="${p.x}" y="${p.y}" width="${p.w}" height="${p.h}" rx="5" class="${n.type==='ficha'?'lq-graph-ficha':'lq-graph-pasaje'}"/><title>${esc(n.title)}</title><text x="${p.x+8}" y="${p.y+21}">${esc(label.length>(n.type==='ficha'?30:21)?label.slice(0,n.type==='ficha'?29:20)+'…':label)}</text>`;
+    return /^\/#\/fichas\/[a-z]+$/.test(n.url||'')?`<a href="${esc(n.url)}" aria-label="Abrir ficha ${esc(n.title)}">${shape}</a>`:`<g>${shape}</g>`;
+  };
+  const lines=edges.map(e=>{const a=positions.get(e.from),b=positions.get(e.to);if(!a||!b)return '';
+    const support=e.type==='apoyo';const d=support?`M${a.x+a.w} ${a.y+a.h/2} C295 ${a.y+a.h/2} 295 ${b.y+b.h/2} ${b.x} ${b.y+b.h/2}`:`M${a.x+a.w} ${a.y+a.h/2} C340 ${a.y+a.h/2} 340 ${b.y+b.h/2} ${b.x+b.w} ${b.y+b.h/2}`;
+    return `<path d="${d}" class="${support?'lq-graph-support':'lq-graph-edge'}"><title>${esc(e.label)}${e.rol?` · ${esc(e.rol)}`:''} · ${esc(e.estado||'')}</title></path>`;}).join('');
+  const titles=new Map(nodes.map(n=>[n.id,n.title||n.reference||n.id]));
+  return `<details class="lq-graph-trace" ${trace.state==='explorando'?'open':''}><summary>Recorrido del grafo · ${steps.filter(s=>s.ok).length} consultas válidas · ${nodes.length} nodos · ${edges.length} aristas</summary>
+    <p class="lq-hint">${trace.state==='explorando'?'El modelo está consultando el catálogo editorial.':trace.state==='sin_consultas_validas'?'El modelo no realizó consultas válidas al grafo.':trace.state==='interrumpido'?'Exploración interrumpida.':'Relaciones editoriales registradas; no equivalen a afirmaciones textuales de Aristóteles.'} ${trace.providerCalls||0} solicitudes de exploración al proveedor.</p>
+    ${nodes.length?`<div class="lq-graph-scroll"><svg viewBox="0 0 680 ${height}" role="group" aria-label="Subgrafo explorado; las fichas son enlaces navegables">${lines}${nodes.map(nodeHtml).join('')}</svg></div>`:''}
+    ${edges.length?`<ul>${edges.map(e=>`<li>${esc(titles.get(e.from)||e.from)} → <b>${esc(e.label)}${e.rol?` (${esc(e.rol)})`:''}</b> → ${esc(titles.get(e.to)||e.to)}</li>`).join('')}</ul>`:''}
+    ${steps.length?`<ol>${steps.map(s=>`<li><code>${esc(s.tool)}</code> · ${s.ok?'consulta válida':'rechazada'}${s.ok?` · ${esc(JSON.stringify(s.args))}`:''}</li>`).join('')}</ol>`:''}
+    ${fichas.length?`<p>${fichas.filter(n=>/^\/#\/fichas\/[a-z]+$/.test(n.url||'')).map(n=>`<a href="${esc(n.url)}">${esc(n.title)}</a>`).join(' · ')}</p>`:''}
+  </details>`;
+}
