+// Pilotos didácticos redactados para Ágora; no son citas de Aristóteles.
+export const enigmas=Object.freeze([
+  {id:'fin',titulo:'El bien que no es un medio',enigma:'Otros bienes pueden elegirse por sí mismos y también por mí. A mí se me elige siempre por mí mismo y nunca en vista de otra cosa. ¿Qué soy?',pistas:['Pensá en la diferencia entre un fin y aquello que se elige en vista de otro.','El Libro I me caracteriza como fin completo y autosuficiente.'],opciones:[['arete','Areté — virtud','La virtud puede elegirse también en vista de la felicidad.'],['eudaimonia','Eudaimonía — felicidad',''],['hedone','Hedoné — placer','El placer puede elegirse también en vista de otro fin.'],['ergon','Érgon — función propia','La función propia ayuda a determinar el contenido del bien humano.']],solucion:'eudaimonia',explicacion:'La felicidad es el fin que se elige siempre por sí mismo y nunca por otra cosa. La distinción formal no basta todavía para determinar en qué consiste: por eso se introduce el argumento del érgon.',referencias:'EN I.7, 1097a25–b6; 1097b20–25.',enlaces:[['#/fichas/felicidad','¿Qué es la felicidad?'],['#/grafos/forma','La forma del fin'],['#/grafos/felicidad','Condiciones de la felicidad']]},
+  {id:'actividad',titulo:'El citarista y el durmiente',enigma:'Un citarista puede poseer una capacidad sin tocar. Cuando la ejerce, ocurre algo que no se reduce a poseerla. ¿Qué concepto permite expresar ese ejercicio?',pistas:['Distinguí la disposición que alguien posee de su ejercicio.','El concepto aparece en la definición del bien humano.'],opciones:[['hexis','Héxis — disposición','Una disposición puede poseerse sin ejercerse.'],['energeia','Enérgeia — actividad',''],['telos','Télos — fin','El fin orienta la actividad, pero no es el término que aquí designa su ejercicio.'],['logos','Lógos — razón','La razón permite caracterizar la actividad humana, pero no designa aquí el ejercicio en general.']],solucion:'energeia',explicacion:'Enérgeia designa la actividad efectiva. El argumento no reduce la felicidad a cualquier actividad: la caracteriza como actividad del alma según la virtud, y la considera en una vida entera.',referencias:'EN I.7, 1098a7–18; I.8, 1098b30–1099a3.',enlaces:[['#/fichas/ergon','El argumento del érgon'],['#/fichas/felicidad','¿Qué es la felicidad?'],['#/grafos/confirmacion','La confirmación']]},
+  {id:'razon',titulo:'Escuchar sin razonar por sí mismo',enigma:'No soy la parte vegetativa ni la razón en sentido propio. Aunque irracional, puedo escuchar y obedecer a la razón. ¿Qué dimensión del alma soy?',pistas:['La amonestación y la exhortación pueden influir en mí.','Estoy relacionada con la formación del carácter y con los deseos.'],opciones:[['vegetativa','Parte vegetativa','Aristóteles la considera ajena a la razón.'],['desiderativa','Parte desiderativa',''],['racional','Razón en sentido propio','El enigma distingue esta parte de la capacidad racional en sentido propio.'],['percepcion','Percepción sensible','La capacidad de percibir no expresa por sí sola esa disposición a obedecer a la razón.']],solucion:'desiderativa',explicacion:'La parte desiderativa participa de la razón en cierto modo, al poder escucharla y obedecerla. Esa distinción prepara la clasificación de las virtudes éticas y dianoéticas, sin reducir el alma a dos partes separables.',referencias:'EN I.13, 1102b13–1103a7.',enlaces:[['#/fichas/alma','¿Cuáles son las partes del alma?'],['#/fichas/virtudes','¿Qué tipos de virtudes hay?'],['#/grafos/alma','El alma']]}
+]);
+const get=id=>{const d=enigmas.find(x=>x.id===id);if(!d)throw Error('Enigma desconocido.');return d;};
+export function iniciarEnigma(id){get(id);return {id,intentos:[],pistas:0,resuelto:false,revelado:false};}
+export function pedirPista(s){const d=get(s.id);return s.resuelto||s.revelado?s:{...s,pistas:Math.min(s.pistas+1,d.pistas.length)};}
+export function responderEnigma(s,id){const d=get(s.id);if(s.resuelto||s.revelado||!d.opciones.some(o=>o[0]===id)||s.intentos.includes(id))throw Error('Opción no disponible.');return {...s,intentos:[...s.intentos,id],resuelto:id===d.solucion};}
+export function revelarEnigma(s){get(s.id);return s.resuelto?s:{...s,revelado:true};}
