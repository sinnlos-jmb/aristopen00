+    { selector: 'node[tipo = "macro"]', style: { 'background-color': '#dbe9e9', 'border-color': '#4c817f', 'font-weight': 650 } },
+    { selector: 'node[tipo = "unidad"]', style: { 'background-color': '#e5ebff', 'border-color': '#627bb2', 'width': 232 } },
