+    </span>
+    <span class="traj-legend__item">
+    <svg width="30" height="22" viewBox="0 0 30 22">
+    <rect x="2" y="6" width="26" height="10" rx="5" fill="rgba(201,169,106,.15)" stroke="rgba(201,169,106,.45)"/>
