+import { esc } from '../ui.js';
+import { parseBook } from '../reader/text.js';
+import { buildEvidenceDocuments, buildSheetLinks } from '../../labo/js/vectorial-engine.js';
+import { controlesTamanoLector, actualizarLectura, cambiarTamanoLector } from '../reader/fontPreferences.js';
+import { CONCEPTS, buildTree } from '../lab/conceptTrees.js';
+const json=async(url,signal)=>{const r=await fetch(url,{cache:'no-store',signal});if(!r.ok)throw Error(`${url}: HTTP ${r.status}`);return r.json();};
+const link=f=>`<a href="${esc(f.url)}" target="_blank" rel="noopener">${esc(f.title)}</a>`;
+const highlighted=(text,hits)=>{let start=0,result='';for(const hit of hits){result+=esc(text.slice(start,hit.start))+`<mark>${esc(hit.form)}</mark>`;start=hit.end;}return result+esc(text.slice(start));};
+function refMarkup(r){return `<li><details><summary>${esc(r.id)} · ${esc(r.role)}</summary><p>${r.registered?'Apoyo vinculado en el catálogo editorial; función propuesta para este árbol.':'Selección provisional para curaduría; no es una arista editorial validada.'}</p>${r.doc?`<p>${esc(r.doc.title)}</p><div class="trees-bilingual"><p>${esc(r.doc.es)}</p><p lang="grc">${esc(r.doc.gr)}</p></div>`:'<p>Texto bilingüe no disponible para este identificador en la revisión activa.</p>'}<div class="esfinge-links">${r.sheets.map(link).join('')}</div></details></li>`;}
+function branch(title,items,empty){return `<details open class="trees-branch"><summary>${esc(title)} (${items.length})</summary>${items.length?`<ul>${items.map(refMarkup).join('')}</ul>`:`<p>${esc(empty)}</p>`}</details>`;}
+export function createLabTreesView(){
+ const el=document.createElement('div');el.className='scrollable has-scroll esfinge-view trees-view';
+ for(const [id,href] of [['esfinge','/css/lab-esfinge-n1u191.css'],['trees','/css/lab-trees-n1u193.css']]){if(!document.querySelector(`link[data-${id}-styles]`)){const css=document.createElement('link');css.rel='stylesheet';css.href=href;css.setAttribute(`data-${id}-styles`,'1');document.head.appendChild(css);}}
+ const abort=new AbortController();let data=null,destroyed=false,selected=CONCEPTS[0].id;
+ el.innerHTML='<div class="esfinge-inner">Cargando corpus y catálogos editoriales…</div>';
+ function render(){if(!data||destroyed)return;const c=CONCEPTS.find(x=>x.id===selected);const tree=buildTree(c,data.docs,data.links,data.ready);
+ const fichas=[...new Map([...data.links.values()].flat().filter(f=>c.sheets.includes(f.id)).map(f=>[f.id,f])).values()];
+ el.innerHTML=`<div class="esfinge-inner trees-inner"><nav><a href="#/lab">← Laboratorio</a> · N1-U.19.3</nav>${controlesTamanoLector()}<h1>Árboles conceptuales y textuales</h1><p>Explorá tres perspectivas de un concepto. Las apariciones son coincidencias de formas, no identificaciones automáticas de sentidos.</p><label>Concepto <select data-tree-concept>${CONCEPTS.map(x=>`<option value="${esc(x.id)}" ${x.id===selected?'selected':''}>${esc(x.title)}</option>`).join('')}</select></label><p class="esfinge-note">Revisión: ${esc(data.revision||'sin revisión')} · ${data.ready?'Catálogos compatibles':'Catálogos incompatibles o ausentes: ramas editoriales desactivadas'}</p><h2>${esc(c.title)}</h2>${data.ready?`<section><h3>Material editorial de Ágora</h3><div class="esfinge-links">${fichas.map(link).join('')}${c.maps.map(m=>`<a href="#/grafos/${esc(m)}" target="_blank" rel="noopener">Mapa: ${esc(m)}</a>`).join('')}<a href="#/chat" target="_blank" rel="noopener">FAQ y diálogo</a></div></section>`:''}<details open class="trees-branch"><summary>Apariciones en el texto · ${tree.counts.gr} griegas / ${tree.counts.es} castellanas</summary><p>Se cuentan formas enteras de palabra en párrafos, sin duplicar subunidades. Listas piloto, no lematización exhaustiva; los dos recuentos no se suman ni se equiparan.</p><details><summary>Formas buscadas</summary><p lang="grc">${esc(c.gr)}</p><p>${esc(c.es)}</p></details><ul>${tree.chapters.map(([ch,rows])=>`<li><details><summary>Libro I · capítulo ${esc(ch)} (${rows.length} párrafos)</summary><ul>${rows.map(({doc,hits})=>`<li><details><summary>${esc(doc.reference)} · ${hits.gr.length} gr / ${hits.es.length} es</summary><div class="trees-bilingual"><p>${highlighted(doc.es,hits.es)}</p><p lang="grc">${highlighted(doc.gr,hits.gr)}</p></div><a href="#/reading" target="_blank" rel="noopener">Biblioteca bilingüe</a></details></li>`).join('')}</ul></details></li>`).join('')}</ul></details>${branch('Definición principal o caracterización',tree.definition,data.ready?'No se ha seleccionado una definición principal para este concepto.':'No disponible sin revisión compatible.')}${branch('Alusiones y pasajes relacionados',tree.allusions,data.ready?'Sin selección provisional.':'No disponible sin revisión compatible.')}<p class="esfinge-note">Las ramas son una vista de lectura, no deducciones ni nuevas relaciones del grafo. Especialmente en lógos, las formas coincidentes pueden tener sentidos diferentes.</p></div>`;actualizarLectura(el);
+ }
+ function change(e){if(e.target.matches('[data-tree-concept]')){selected=e.target.value;render();el.querySelector('[data-tree-concept]')?.focus();}}
+ function click(e){const b=e.target.closest('[data-reader-font-step]');if(b&&el.contains(b))cambiarTamanoLector(el,Number(b.dataset.readerFontStep));}
+ el.addEventListener('change',change);el.addEventListener('click',click);
+ Promise.all([json('/api/labo/lectura',abort.signal),fetch('/api/texto/EN_libro1_v8.txt',{cache:'no-store',signal:abort.signal}).then(r=>{if(!r.ok)throw Error('Texto bilingüe no disponible');return r.text();}),...['n1u5-fichas-explicativas','n1u6-puentes-explicativos','n1u7-fichas-red-piloto'].map(n=>json(`/lab/${n}.json`,abort.signal).catch(()=>null))]).then(([lectura,raw,f5,f6,f7])=>{if(destroyed)return;const corpus=buildEvidenceDocuments(lectura,parseBook(raw));const ready=!!lectura.revision&&[f5,f6,f7].every(f=>f?.fuente?.revision===lectura.revision);data={docs:corpus.documents,revision:lectura.revision,ready,links:ready?buildSheetLinks([f5,f7],f6):new Map()};render();}).catch(e=>{if(!destroyed)el.innerHTML=`<div class="esfinge-inner"><a href="#/lab">← Laboratorio</a><p role="alert">${esc(e.message)}</p></div>`;});
+ return {el,destroy(){destroyed=true;abort.abort();el.removeEventListener('change',change);el.removeEventListener('click',click);}};
+}
diff --git a/public/scripts/check-n1u193.mjs b/public/scripts/check-n1u193.mjs
