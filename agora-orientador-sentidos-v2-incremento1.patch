@@ -0,0 +1,26 @@
+import { test, expect } from '@playwright/test';
+
+test('V2 preserva una comparación entre tres conceptos y permite precisar el sentido', async ({ page }) => {
+  await page.goto('/#/lab/orientador', { waitUntil: 'domcontentloaded' });
+  await page.locator('#orientador-texto').fill('¿Cuáles son las diferencias entre disposición, virtud y felicidad?');
+  await page.getByRole('button', { name: 'Comenzar orientación' }).click();
+  await expect(page.locator('#orientador-lectura-v2')).toContainText('comparacion_multiple');
+  await expect(page.locator('#orientador-lectura-v2')).toContainText('hexis, arete, eudaimonia');
+  await expect(page.locator('#orientador-lectura-v2')).toContainText('no acreditadas');
+  await page.locator('[data-opcion="hexis"]').click();
+  await page.locator('#orientador-sentido-texto').fill('Disposición adquirida en el hábito');
+  await page.getByRole('button', { name: 'Conservar precisión del sentido' }).click();
+  await expect(page.locator('#lab-orientador')).toContainText('Disposición adquirida en el hábito');
+  await expect(page.locator('#orientador-json')).toContainText('precision_sentido');
+  await expect(page.locator('[data-opcion="distinguir"]')).toBeVisible();
+});
+
+test('V2 no confunde el comparativo «mejor» con un tema autónomo', async ({ page }) => {
